# Minimal/normal setup.
# This file intentionally contains the keys most installations actually change.
# Advanced tuning options exist in src/powerbuddy/config.py defaults and are optional.

# Core runtime
POWERBUDDY_DB_PATH=./data/powerbuddy.db
POWERBUDDY_TIMEZONE=Europe/Copenhagen
POWERBUDDY_INVERTER_TYPE=fronius
POWERBUDDY_FRONIUS_URL=http://FRONIUS_HOST/solar_api/v1/GetPowerFlowRealtimeData.fcgi
POWERBUDDY_PRICE_PROVIDER=elprisenligenu
POWERBUDDY_PRICE_AREA=DK2

# Execution
POWERBUDDY_EXECUTION_ENABLED=true
POWERBUDDY_EXECUTION_INTERVAL_SECONDS=10
POWERBUDDY_FRONIUS_ACTION_METHOD=POST
POWERBUDDY_FRONIUS_ACTION_AUTH_USER=technician
POWERBUDDY_FRONIUS_ACTION_AUTH_PASS=change-me
POWERBUDDY_FRONIUS_ACTION_TIMEOUT_SECONDS=10

# Modbus fallback (used when Fronius action URLs are not configured)
POWERBUDDY_MODBUS_HOST=
POWERBUDDY_MODBUS_PORT=502
POWERBUDDY_MODBUS_UNIT_ID=1
POWERBUDDY_MODBUS_CHARGE_WRITES_JSON=[]
POWERBUDDY_MODBUS_HOLD_WRITES_JSON=[]
POWERBUDDY_MODBUS_DISCHARGE_WRITES_JSON=[]
POWERBUDDY_MODBUS_CHARGE_POWER_SETPOINT_ADDRESS=0
POWERBUDDY_MODBUS_CHARGE_POWER_SETPOINT_SCALE_W=10

# Battery power limits
# Keep auto unless you explicitly need fixed limits.
POWERBUDDY_MAX_CHARGE_KW=auto
POWERBUDDY_MAX_DISCHARGE_KW=auto

# Consumption and planning baseline
POWERBUDDY_EXPECTED_DAILY_CONSUMPTION_KWH=60
POWERBUDDY_DYNAMIC_CONSUMPTION_ENABLED=true
POWERBUDDY_DYNAMIC_CONSUMPTION_LOOKBACK_DAYS=7
POWERBUDDY_DYNAMIC_CONSUMPTION_MIN_SAMPLES_PER_DAY=24
POWERBUDDY_PRICE_RECHECK_INTERVAL_MINUTES=60
POWERBUDDY_PRICE_FETCH_DAYS_AHEAD=1
POWERBUDDY_PRICE_REPLAN_THRESHOLD_ORE=2.0
POWERBUDDY_FORCE_LOAD_SOLAR_AWARE_ENABLED=false

# Optional: declare PV arrays for orientation-aware weather shaping.
# If enabled but arrays are missing/invalid, planner falls back to standard weather+historical behavior.
POWERBUDDY_SOLAR_SITE_DECLARED_ENABLED=false
# JSON array with kWp and orientation per array (azimuth: degrees from north clockwise).
# Example:
# POWERBUDDY_SOLAR_ARRAYS_JSON=[{"kwp":5.7,"azimuth_deg":210,"tilt_deg":30},{"kwp":7.3,"azimuth_deg":300,"tilt_deg":25}]
POWERBUDDY_SOLAR_ARRAYS_JSON=

# Tariff and VAT
POWERBUDDY_TARIFF_NETWORK_OWNER=Radius Elnet A/S
POWERBUDDY_TARIFF_NETWORK_CODE=DT_C_01
POWERBUDDY_TARIFF_ENERGINET_ORE=6.0
POWERBUDDY_TARIFF_ELAFGIFT_ORE=76.10
POWERBUDDY_TARIFF_VAT_FACTOR=1.25

# CORS
POWERBUDDY_CORS_ALLOWED_ORIGINS=https://example.com
POWERBUDDY_CORS_ALLOW_CREDENTIALS=false

# Dashboard (native FastAPI UI)
POWERBUDDY_DASHBOARD_ENABLED=true
POWERBUDDY_DASHBOARD_SECRET=change-me-secret
POWERBUDDY_DASHBOARD_PASSWORDS=change-me-password
POWERBUDDY_DASHBOARD_TRUSTED_IPS=127.0.0.1,::1
POWERBUDDY_DASHBOARD_SESSION_COOKIE=powerbuddy_dashboard
POWERBUDDY_DASHBOARD_SESSION_TTL_SECONDS=86400

# Easee EV integration (optional)
POWERBUDDY_EASEE_ENABLED=false
POWERBUDDY_EASEE_BASE_URL=https://api.easee.com/api
POWERBUDDY_EASEE_USERNAME=
POWERBUDDY_EASEE_PASSWORD=

# Example tuning profile (optional)
# POWERBUDDY_AUTO_ONLY_EXPENSIVE_QUANTILE=0.65
# POWERBUDDY_CHEAP_SLOT_QUANTILE=0.30
# POWERBUDDY_PLANNING_SANITY_MIN_EXPENSIVE_AUTO_SHARE=0.80
# POWERBUDDY_PLANNING_SANITY_CHARGE_CANDIDATE_QUANTILE=0.30
# POWERBUDDY_PLANNING_SANITY_EXPENSIVE_QUANTILE=0.65
# POWERBUDDY_PRECHEAP_AUTO_CONVERT_MIN_DELTA_ORE=0.5
